<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OcarinaForge.Import</RootNamespace>
    <AssemblyName>OcarinaForge.Import</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Description>Dump importers for a native Ocarina Forge. No Godot dependency, so a future editor can reuse this library.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\fixtures\v10-tree.bfres">
      <LogicalName>v10-tree.bfres</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
